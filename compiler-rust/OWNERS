crates/lwc-compiler-napi/src/errors.rs	js	# D-0200
crates/lwc-compiler-napi/src/aggregate.rs	js
crates/lwc-compiler-napi/src/single_error.rs	js
crates/lwc-compiler-napi/src/error_urls.rs	js
