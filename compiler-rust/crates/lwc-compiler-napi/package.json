{
  "name": "lwc-compiler-rs",
  "version": "0.1.0",
  "private": true,
  "description": "Rust (napi) port of @lwc/compiler. Working name pending Tariq (D-0202); not published.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "name": "lwc-compiler",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "npx -y @napi-rs/cli@2.18.4 build --platform --release --js false --dts napi.gen.d.ts"
  },
  "optionalDependencies": {
    "lwc-compiler-rs-linux-x64-gnu": "0.1.0",
    "lwc-compiler-rs-linux-arm64-gnu": "0.1.0",
    "lwc-compiler-rs-darwin-x64": "0.1.0",
    "lwc-compiler-rs-darwin-arm64": "0.1.0",
    "lwc-compiler-rs-win32-x64-msvc": "0.1.0"
  }
}
