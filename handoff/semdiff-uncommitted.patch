+/// (name, oracle, rust, expected rewrite reason, expected (class, reason) after exec).
+type SpellingCase = (&'static str, String, String, &'static str, (&'static str, &'static str));
+
+fn spelling_cases() -> Vec<SpellingCase> {
+    let arrow = |s: String| s.replacen("function (item) {\n    return", "item => {\n    return", 1);
+    let diff = ("DIFFERENT", "exec-static-spelling-differs");
+    vec![
+        // (a) printer-equal pairs: only spelling differs (token-spelling-differs; a grouping paren is an AST node, so
+        // printer-equal-ast-differs).
+        ("num", rust(), rust_with("key: 1,", "key: 0b1,"), "token-spelling-differs", diff),
+        ("paren-arrow", arrow(rust()), arrow(rust()).replacen("item => {", "(item) => {", 1), "token-spelling-differs", diff),
+        ("paren-expr", rust(), rust_with("$cmp.flag ? api_text", "($cmp.flag) ? api_text"), "printer-equal-ast-differs", diff),
+        // (b) the same spellings next to a real code difference (stc0 hoisted vs inlined): printed-differs hides them.
+        ("masked-num", oracle(), rust_with("key: 1,", "key: 0b1,"), "printed-differs", diff),
+        ("masked-paren", arrow(oracle()), arrow(rust()).replacen("item => {", "(item) => {", 1), "printed-differs", diff),
+        // Controls: hoisting alone is still EQUIVALENT-BY-EXECUTION; quote spelling alone never reaches exec.
+        ("hoist-only", oracle(), rust(), "printed-differs", ("EQUIVALENT-BY-EXECUTION", "exec-equal")),
+        ("quotes-only", rust(), rust_with(r#""lang": "en""#, r#"'lang': 'en'"#), "printer-equal", ("EQUIVALENT-BY-REWRITE", "printer-equal")),
+    ]
+}
